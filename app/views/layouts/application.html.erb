<!DOCTYPE html>
<html>
  <head>
    <title>AdyenShop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  </head>

  <body>
    <div class="head">
      <p> <%= link_to 'AdyenShop', root_path %></p>
      
      <nav class="navbar">
        <% if user_signed_in? %>
          <span><%= current_user.email %></span>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "logout-button" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, method: :create, class: "login-button" %>
        <% end %>
      </nav>
    </div>
    <%= yield %>
    <div class="flash-container">
      <% flash.each do |type, message| %>
        <div class="flash-message flash-<%= type %>"><%= message %></div>
      <% end %>
    </div>
  </body>
</html>
