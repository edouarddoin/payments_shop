<div class="product_card">
    <p> <%= @product.name %></p>
    <p>Product left in stock: <%= @product.stock %></p>
    <p>Price:<%=humanized_money(@product.price)%>€</p>

  <%# <% ER %>
  <%# <%=  ==PE %>


  <%= form_with url: orders_path, data: {turbo: false} do %>
    <%= hidden_field_tag 'product_id', @product.id %>
    <%= submit_tag 'Purchase', class: 'btn btn-primary' %>
  <% end %>
</div>