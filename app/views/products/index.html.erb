

<% @products.each do |product| %>
  <div class= "product_card">
    <h3><%= product.name %></h3>
    <p>Product description : <%= product.description %></p>
    <p>Product stock : <%= product.stock %></p>
    <p class="product_price"> Product price : <%= humanized_money(product.price)%>€</p>
    <p><%= button_to "More info", product_path(product), method: :get %></p>
  </div>
<% end %>

<div class="addproduct">
  <%= button_to "add a product", new_product_path, method: :get  %>
</div>
