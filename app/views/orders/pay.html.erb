<h2 align="center">Pay with Adyen Dropin</h2>
<div class="cart">
     <div id="dropin-container"
     data-session-id="<%= @adyen_session_id %>"
     data-session-data="<%= @adyen_session_data %>"
     data-amount="<%= @order_price %>"
     data-client-key="<%= ENV.fetch('ADYEN_CLIENT_KEY') %>">
     </div>
     <div class="cart_summary">
          <h1>Your order summary</h1>
          <p>Order <%= @order.id %> total price is : <%= @order_price %> <%= @currency %></p>
          <P>Products in your order : <%= @order.product.name %></P>
          <p>Add a discount code to your order</p>
          <%= form_with url: apply_discount_order_path(@order), method: :post, local: true do |form| %>
          <%= form.text_field :discount_code, placeholder: "Enter discount code" %>
          <%= form.submit "Apply" %>
          <% end %>
     </div>
</div>

<p align="center"><%= link_to 'Return to order page', order_path(@order) %></p>

