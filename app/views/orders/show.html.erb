<div class="container">
  <% if @order.present? %>
    <div class="col-md-3">
      <p>Current user Id: <%= current_user.id %></p>
      <p>Order <%= @order.id %> status is : <%= @order.status.name %></p>

      <%= form_with url: pay_order_path(@order), method: :post, data: {turbo: false} do %>
        <%= submit_tag 'Pay my order', class: 'btn btn-primary' %>
      <% end %>
      <p><%= link_to 'Return the homepage', products_path %></p>
    </div>
  <% else %>
    <p>Order not found.</p>
    </div>
  <% end %>
</div>