<div class="container">
  <% if @order.present? %>
  <div class="col-md-3">
    <p>
      Current user Id: <%= current_user.id %>
    </p>
    <p>
      Order <%= @order.id %> status is : <%= @order.status.name %>
    </p>
  </div>
  <%= link_to 'Return the homepage', products_path %>

  <%= form_with url: pay_order_path(@order), method: :post, data: {turbo: false} do %>
  <%= submit_tag 'Pay my order', class: 'btn btn-primary' %>

<% end %>
  <% else %>
  <div class="container">
    <p>Order not found.</p>
  </div>
<% end %>

</div>

<%#= button_to 'Pay my order', pay_orders_path, params: { order_id: @order.id } %>